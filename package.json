{
  "name": "amazon-plugin-selector",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Amazon US category-page product research workflow enriched by Sorftime or SellerSprite data.",
  "scripts": {
    "test": "node --test tests\\*.test.ts",
    "collect": "node src/cli.ts collect",
    "collect:sellersprite": "node src/cli.ts collect --provider sellersprite",
    "evaluate": "node src/cli.ts evaluate",
    "evaluate:sellersprite": "node src/cli.ts evaluate --provider sellersprite",
    "profile:sellersprite": "node src/cli.ts profile --provider sellersprite",
    "serve": "node src/cli.ts serve"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "playwright": "^1.55.0"
  },
  "engines": {
    "node": ">=22.5"
  }
}
